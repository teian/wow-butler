<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct distribution: addon scanning, updates and Git backups need access
	     to WoW installations and external programs outside the app container. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
